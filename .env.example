# Supabase 프로젝트 설정 > API 에서 확인 (무료 티어)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 개발자센터 > 앱 설정 > 앱 키 에서 확인 (톡캘린더 연동용).
# 로그인이 아니라 talk_calendar 스코프만 직접 요청하는 별도 흐름이라 계정_email과 무관하다
# (src/lib/kakao.ts, CLAUDE.md의 Kakao Talk Calendar integration 절 참고).
KAKAO_REST_API_KEY=
# 카카오 앱 설정 > 보안 > Client Secret이 "사용함"이면 필수, "사용 안 함"이면 비워둬도 된다.
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_JS_KEY=
